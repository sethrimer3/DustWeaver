{
  "main": "electron/main.cjs",
  "name": "dustweaver",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint src/",
    "preview": "vite preview",
    "electron": "npm exec -- electron --no-sandbox .",
    "desktop": "npm run build && npm exec -- electron --no-sandbox .",
    "test": "node --import tsx --test 'src/tests/**/*.test.ts'",
    "build:atlases": "node scripts/build-sprite-atlases.mjs",
    "validate:atlases": "node scripts/validate-sprite-atlases.mjs",
    "compare:atlases": "node scripts/compare-sprite-atlases.mjs",
    "preview:atlases": "node scripts/preview-sprite-atlases.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "electron": "^42.2.0",
    "eslint": "^10.2.0",
    "tsx": "^4.22.3",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.58.2",
    "vite": "^5.2.11"
  }
}
